# Copy this file to .env and adjust as needed

# Secret used to sign JWTs — change this in production
SECRET_KEY=change-this-to-a-long-random-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# SQLite database file (relative to backend/ directory)
DATABASE_URL=sqlite:///./a3.db

# Comma-separated list of origins allowed to call this API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI_PROVIDER=mock uses deterministic rule-based analysis (default, no external calls)
# AI_PROVIDER=ollama would call a local Ollama model via CrewAI (not implemented yet,
# see app/services/sentinel.py for the swap point)
AI_PROVIDER=mock

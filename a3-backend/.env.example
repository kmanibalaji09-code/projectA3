# Copy this file to .env and adjust as needed

# Secret used to sign JWTs — change this in production
SECRET_KEY=change-this-to-a-long-random-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# SQLite database file (relative to backend/ directory)
DATABASE_URL=sqlite:///./a3.db
# Vercel: use a hosted PostgreSQL URL, e.g. postgresql+psycopg://user:password@host/db

# Comma-separated list of origins allowed to call this API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Vercel: https://your-frontend.vercel.app

# AI_PROVIDER=ollama uses the local Ollama model, with rule-based fallback if unavailable
AI_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
